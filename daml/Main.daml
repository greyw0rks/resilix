module Main where

import DA.List (unique)

{-
  Reference governance contracts for Canton Resilience.

  These model the *control layer* only: a policy (who may act and how many
  must approve), a generic privileged action request, per-party approvals,
  execution gated on the threshold, and an immutable audit record.

  The action is deliberately generic (verb + target + detail) so the same
  contracts protect a treasury transfer, a token mint, a fee change or a
  protocol pause.

  Distributed hosting is modelled by HostingGroup: the set of operator parties
  running an application and the minimum number that must stay online. Each
  operator reports its own node state, and Execute refuses to run while the
  application is under-hosted — so availability is enforced on the ledger, not
  in the UI. The *real* multi-participant node topology is BitSafe's
  Decentralization Manager's job and stays a documented seam.
-}

-- | Shared-control policy: a named quorum over a set of parties.
template Policy
  with
    operator : Party        -- administers the policy contract
    members : [Party]       -- parties eligible to approve
    threshold : Int         -- approvals required to execute an action
    application : Text       -- e.g. "Treasury", "Protocol Governance"
  where
    signatory operator
    observer members

    -- A policy is only well-formed with a non-empty, duplicate-free member set
    -- and a threshold that at least one member and at most all members can meet.
    ensure not (null members)
        && unique members
        && threshold > 0
        && threshold <= length members

    -- Open a privileged action against this policy.
    nonconsuming choice RequestAction : ContractId ActionRequest
      with
        requester : Party
        verb : Text
        target : Text
        detail : Text
        reference : Text
      controller requester
      do
        assertMsg "Requester must be a policy member" (requester `elem` members)
        create ActionRequest with
          operator; members; threshold; application
          requester; verb; target; detail; reference
          approvals = []

    choice UpdateThreshold : ContractId Policy
      with newThreshold : Int
      controller operator
      do
        assertMsg "Threshold out of range"
          (newThreshold > 0 && newThreshold <= length members)
        create this with threshold = newThreshold

-- | A privileged action awaiting quorum.
template ActionRequest
  with
    operator : Party
    members : [Party]
    threshold : Int
    application : Text
    requester : Party
    verb : Text
    target : Text
    detail : Text
    reference : Text
    approvals : [Party]
  where
    signatory operator, requester
    observer members

    -- Record an approval from an eligible member.
    choice Approve : ContractId ActionRequest
      with approver : Party
      controller approver
      do
        assertMsg "Approver is not a policy member" (approver `elem` members)
        assertMsg "Approver has already approved" (approver `notElem` approvals)
        create this with approvals = approver :: approvals

    -- Execute once the approval threshold is met AND the application is
    -- adequately hosted; emits an audit record.
    --
    -- `hostingGroup` is the application's live HostingGroup contract id. It is
    -- an argument rather than a field because ReportOffline/ReportOnline
    -- consume and recreate that contract, so any id stored here would go stale
    -- on the first status change. Accepting it as an argument cannot be used to
    -- bypass the gate: exactly one HostingGroup is live per application (only
    -- the control-plane operator — the signatory — can create one, and every
    -- status report consumes the old one), and the choice re-checks that the
    -- fetched group is the one for this application.
    choice Execute : ContractId AuditRecord
      with
        executor : Party
        hostingGroup : ContractId HostingGroup
      controller executor
      do
        assertMsg "Executor is not a policy member" (executor `elem` members)
        assertMsg "Approval threshold not met" (length approvals >= threshold)
        hosting <- fetch hostingGroup
        assertMsg "Hosting contract belongs to a different application"
          (hosting.application == application)
        let online = length hosting.nodes - length hosting.offline
        assertMsg "Hosting below threshold — application unavailable"
          (online >= hosting.threshold)
        create AuditRecord with
          operator; members; application
          verb; target; detail; reference
          approvals; executor
          onlineOperators = online
          hostingThreshold = hosting.threshold

    -- Withdraw a pending request. The policy operator can always reject; the
    -- original requester can withdraw their own request. Archives the request
    -- without producing an audit execution record.
    choice Reject : ()
      with canceller : Party
      controller canceller
      do
        assertMsg "Only the operator or the requester may reject"
          (canceller == operator || canceller == requester)
        pure ()

-- | Immutable trace of an executed action. `onlineOperators` / `hostingThreshold`
-- capture the hosting state at the moment of execution, so the resilience fact
-- is part of the record rather than a UI annotation.
template AuditRecord
  with
    operator : Party
    members : [Party]
    application : Text
    verb : Text
    target : Text
    detail : Text
    reference : Text
    approvals : [Party]
    executor : Party
    onlineOperators : Int
    hostingThreshold : Int
  where
    signatory operator
    observer members

-- | Distributed hosting: the operator parties running an application and the
-- minimum number that must stay online for it to remain available.
--
-- Each hosting operator reports its *own* node state (controller = that node),
-- which keeps the signal decentralized: no admin asserts on a node's behalf.
-- A non-operator cannot even see the contract (observers are the members and
-- the nodes), so an outsider is blocked by invisibility before the explicit
-- membership assertion is reachable — the same pattern as ActionRequest.
template HostingGroup
  with
    operator : Party        -- control-plane operator, administers the group
    members : [Party]       -- policy members; observers so hosting health is visible to them
    application : Text
    nodes : [Party]         -- hosting-operator parties
    threshold : Int         -- minimum online operators to remain available
    offline : [Party]       -- subset of nodes currently reported down
  where
    signatory operator
    -- Members and nodes are both observers: policy members can see the
    -- application's hosting health, and operators can see (and report on) the
    -- group. The `ensure` below keeps the operator out of both lists, so a
    -- party is never both signatory and observer.
    observer (members ++ nodes)

    ensure not (null nodes)
        && unique nodes
        && threshold > 0
        && threshold <= length nodes
        && all (\n -> n `elem` nodes) offline
        && unique offline
        && operator `notElem` members
        && operator `notElem` nodes

    -- An operator declares its own node down (graceful withdrawal or an
    -- operator taking infrastructure out of service).
    choice ReportOffline : ContractId HostingGroup
      with node : Party
      controller node
      do
        assertMsg "Not a hosting operator for this application" (node `elem` nodes)
        assertMsg "Operator is already offline" (node `notElem` offline)
        create this with offline = node :: offline

    -- ...and back online.
    choice ReportOnline : ContractId HostingGroup
      with node : Party
      controller node
      do
        assertMsg "Not a hosting operator for this application" (node `elem` nodes)
        assertMsg "Operator is already online" (node `elem` offline)
        create this with offline = filter (/= node) offline
