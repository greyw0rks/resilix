module Init where

import Daml.Script
import Main

{-
  LocalNet bootstrap for Canton Resilience.

  Allocates the demo parties and creates one HostingGroup and one Policy per
  reference application (mirroring lib/applications.ts), then returns the
  allocated party ids — including the hosting-operator parties — so the
  bring-up script (scripts/localnet.sh) can write LEDGER_PARTY_MAP for the
  frontend. Run with:

    daml script --dar .daml/dist/canton-resilience-0.1.0.dar \
      --script-name Init:initialize --ledger-host localhost --ledger-port 6865 \
      --output-file init-output.json

  (host/port depend on the ledger brought up in Phase 0.)
-}

data PartyEntry = PartyEntry
  with
    slug : Text     -- short id used by the frontend (lib/applications.ts)
    party : Party   -- fully-qualified allocated Canton party
  deriving (Show, Eq)

data LedgerInit = LedgerInit
  with
    operator : Party
    parties : [PartyEntry]
  deriving (Show, Eq)

initialize : Script LedgerInit
initialize = do
  operator <- allocatePartyByHint (PartyIdHint "Operator")
  alice <- allocatePartyByHint (PartyIdHint "Alice")
  bob <- allocatePartyByHint (PartyIdHint "Bob")
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  dave <- allocatePartyByHint (PartyIdHint "Dave")
  erin <- allocatePartyByHint (PartyIdHint "Erin")

  -- Hosting operators (mirrors lib/applications.ts hostingNodes). These are
  -- real parties: each one reports its own node state through HostingGroup.
  opAlpha <- allocatePartyByHint (PartyIdHint "OperatorAlpha")
  opBeta <- allocatePartyByHint (PartyIdHint "OperatorBeta")
  opGamma <- allocatePartyByHint (PartyIdHint "OperatorGamma")
  opDelta <- allocatePartyByHint (PartyIdHint "OperatorDelta")
  opEpsilon <- allocatePartyByHint (PartyIdHint "OperatorEpsilon")

  let smallNodes = [opAlpha, opBeta, opGamma]                     -- Nodes A/B/C
  let largeNodes = [opAlpha, opBeta, opGamma, opDelta, opEpsilon] -- Nodes A–E

  -- One HostingGroup per reference application, created before its Policy so
  -- the group is live for the app's whole lifetime. All nodes start online.
  -- The frontend finds them by `application` (see app/api/ledger/route.ts).
  _ <- submit operator $ createCmd HostingGroup with
    operator; members = [alice, bob, carol]; application = "Treasury"
    nodes = smallNodes; threshold = 2; offline = []
  _ <- submit operator $ createCmd HostingGroup with
    operator; members = [alice, bob, carol, dave]; application = "Token Administration"
    nodes = smallNodes; threshold = 2; offline = []
  _ <- submit operator $ createCmd HostingGroup with
    operator; members = [alice, bob, carol]; application = "Trading Administration"
    nodes = smallNodes; threshold = 2; offline = []
  _ <- submit operator $ createCmd HostingGroup with
    operator; members = [alice, bob, carol, dave, erin]; application = "Protocol Governance"
    nodes = largeNodes; threshold = 3; offline = []

  -- One Policy per reference application (matches lib/applications.ts).
  _ <- submit operator $ createCmd Policy with
    operator; members = [alice, bob, carol]; threshold = 2
    application = "Treasury"
  _ <- submit operator $ createCmd Policy with
    operator; members = [alice, bob, carol, dave]; threshold = 3
    application = "Token Administration"
  _ <- submit operator $ createCmd Policy with
    operator; members = [alice, bob, carol]; threshold = 2
    application = "Trading Administration"
  _ <- submit operator $ createCmd Policy with
    operator; members = [alice, bob, carol, dave, erin]; threshold = 3
    application = "Protocol Governance"

  -- Return the party map so the frontend can resolve UI slugs to parties.
  pure LedgerInit with
    operator
    parties =
      [ PartyEntry "alice" alice
      , PartyEntry "bob" bob
      , PartyEntry "carol" carol
      , PartyEntry "dave" dave
      , PartyEntry "erin" erin
      , PartyEntry "opalpha" opAlpha
      , PartyEntry "opbeta" opBeta
      , PartyEntry "opgamma" opGamma
      , PartyEntry "opdelta" opDelta
      , PartyEntry "opepsilon" opEpsilon
      ]
